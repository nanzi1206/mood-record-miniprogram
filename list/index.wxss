.emo-box {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  flex-wrap: wrap;
}
.emo-item {
  padding: 20rpx 30rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
}
.emo-item.active {
  background: #4CAF50;
  color: white;
}
.input-box {
  margin: 20rpx;
}
textarea {
  min-height: 200rpx;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 10rpx;
}
button {
  margin: 20rpx;
}
.record-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 40rpx 20rpx 20rpx;
}
.record-item {
  background: #fafafa;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  line-height: 1.6;
}