<!--pages/index/index.wxml-->
<view class="container">
  <!-- 标题 -->
  <view class="title">记心情</view>

  <!-- 心情选项（带表情） -->
  <view class="mood-section">
    <text class="label">今天的心情是？</text>
    <view class="mood-list">
      <view 
        wx:for="{{moodList}}" 
        wx:key="index"
        class="mood-item {{currentMood === item.value ? 'active' : ''}}"
        bindtap="selectMood"
        data-value="{{item.value}}"
      >
        <text class="mood-emoji">{{item.emoji}}</text>
        <text class="mood-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 想法输入框（可编辑） -->
  <textarea 
    class="thought-input"
    placeholder="写下此刻想法.."
    placeholder-style="color:#ccc;"
    value="{{currentThought}}"
    bindinput="onThoughtInput"
    maxlength="200"
    auto-height
  />

  <!-- 保存按钮 -->
  <button class="save-btn" bindtap="saveMood">保存心情</button>

  <!-- 历史记录标题 -->
  <view class="history-title">历史记录</view>

  <!-- 历史记录列表 -->
  <view class="history-list">
    <block wx:for="{{historyList}}" wx:key="id">
      <view class="record-item">
        <view class="record-header">
          <!-- 显示表情和心情文字 -->
          <text class="mood-text">{{item.emoji}} {{item.mood}}</text>
          <text class="delete-btn" bindtap="deleteRecord" data-id="{{item.id}}">删除</text>
        </view>
        <view class="thought-text">想法：{{item.thought || '无'}}</view>
        <view class="time-text">{{item.time}}</view>
      </view>
    </block>
    <view wx:if="{{historyList.length === 0}}" class="empty">暂无记录，写一条吧~</view>
  </view>
</view>