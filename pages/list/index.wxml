<view class="container">
  <text class="title">我的心情记录</text>

  <!-- 没数据时的提示 -->
  <view wx:if="{{records.length === 0}}" class="empty">
    暂无记录，快去首页保存心情吧~
  </view>

  <!-- 有数据时的列表 -->
  <view wx:else class="record-list">
    <view wx:for="{{records}}" wx:key="index" class="record-item">
      <text class="mood">心情：{{item.mood}}</text>
      <text class="note">备注：{{item.note || '无'}}</text>
      <text class="date">时间：{{item.date}}</text>
    </view>
  </view>
</view>