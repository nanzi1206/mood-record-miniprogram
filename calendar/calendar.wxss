/* 全局重置 */
page {
  background-color: #f5f7fa;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx;
}

/* 标题栏 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 星期栏 */
.weekdays {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.weekday {
  width: 10%;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 日期网格 */
.days {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.day-item {
  width: 12%;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0;
  border-radius: 12rpx;
  transition: background 0.2s ease;
}

.day-item:active {
  background: #e8f3ff;
}

.day-text {
  font-size: 28rpx;
  color: #333;
}

/* 今天高亮样式（你后续可以加逻辑给今天的日期加上类名） */
.day-item.today {
  background: #409eff;
}
.day-item.today .day-text {
  color: #fff;
  font-weight: bold;
}

/* 底部提示 */
.tip {
  text-align: center;
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #666;
}