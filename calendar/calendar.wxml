<view class="page">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">我的心情日历</text>
  </view>

  <!-- 星期栏 -->
  <view class="weekdays">
    <text class="weekday">周一</text>
    <text class="weekday">周二</text>
    <text class="weekday">周三</text>
    <text class="weekday">周四</text>
    <text class="weekday">周五</text>
    <text class="weekday">周六</text>
    <text class="weekday">周日</text>
  </view>

  <!-- 日期网格（这里你后续可以自己循环渲染日期，先给你把结构和样式搭好） -->
  <view class="days">
    <!-- 示例：你后面可以用 wx:for 循环生成，这里先写个静态的给你看效果 -->
    <view class="day-item" bindtap="showMood" data-day="2026-05-19">
      <text class="day-text">19</text>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="tip">
    <text>{{moodText}}</text>
  </view>
</view>